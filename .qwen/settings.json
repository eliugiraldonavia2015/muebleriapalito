      "Bash('// ─── product image file picker ───',)",
      "Bash('var _prodimgdirty = false;',)",
      "Bash('',)",
      "Bash('function setproductimagepreview(url) {',)",
      "Bash('  var hidden = document.getelementbyid(\"prodimage\");',)",
      "Bash('  var preview = document.getelementbyid(\"prodimagepreview\");',)",
      "Bash('  var status = document.getelementbyid(\"prodimagestatus\");',)",
      "Bash('  var fileinput = document.getelementbyid(\"prodimagefile\");',)",
      "Bash('  hidden.value = url || \"\";',)",
      "Bash('  if (url && url.trim()) {',)",
      "Bash('    preview.src = url;',)",
      "Bash('    preview.style.display = \"block\";',)",
      "Bash('    status.textcontent = \"imagen actual del producto\";',)",
      "Bash('    status.style.color = \"var(--gray)\";',)",
      "Bash('    console.log(\"[img] preview set:\", url);',)",
      "Bash('  } else {',)",
      "Bash('    preview.style.display = \"none\";',)",
      "Bash('    status.textcontent = \"sin imagen\";',)",
      "Bash('  }',)",
      "Bash('  if (fileinput) fileinput.value = \"\";',)",
      "Bash('  _prodimgdirty = false;',)",
      "Bash('}',)",
      "Bash('document.getelementbyid(\"prodimagefile\").addeventlistener(\"change\", async function(e) {',)",
      "Bash('  var file = e.target.files[0];',)",
      "Bash('  if (!file) return;',)",
      "Bash('  console.log(\"[img] file selected:\", file.name, math.round(file.size/1024) + \"kb\");',)",
      "Bash('  // show local preview immediately',)",
      "Bash('  var localurl = url.createobjecturl(file);',)",
      "Bash('  preview.src = localurl;',)",
      "Bash('  preview.style.display = \"block\";',)",
      "Bash('  status.textcontent = \"subiendo a bunny cdn...\";',)",
      "Bash('  status.style.color = \"var(--copper-lt)\";',)",
      "Bash('  try {',)",
      "Bash('    const cdnurl = await uploadimagetobunny(file, \"products\");',)",
      "Bash('    document.getelementbyid(\"prodimage\").value = cdnurl;',)",
      "Bash('    preview.src = cdnurl;',)",
      "Bash('    status.textcontent = \"✅ imagen subida — \" + cdnurl;',)",
      "Bash('    status.style.color = \"var(--green-ok)\";',)",
      "Bash('    _prodimgdirty = true;',)",
      "Bash('    console.log(\"[img] ✅ uploaded to bunny:\", cdnurl);',)",
      "Bash('  } catch (err) {',)",
      "Bash('    status.textcontent = \"❌ error: \" + err.message;',)",
      "Bash('    status.style.color = \"var(--red-fail)\";',)",
      "Bash('    console.error(\"[img] ❌ upload failed:\", err);',)",
